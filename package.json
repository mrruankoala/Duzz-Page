{
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css --minify",
    "build:copy": "rimraf dist && cpx \"src/**/*\" dist && cpx \"assets/**/*\" dist",
    "build": "npm run build:css && npm run build:copy",
    "start": "npx http-server dist -p 8000"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "cpx": "^1.5.0"
  }
}
